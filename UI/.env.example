# ─────────────────────────────────────────────────────────────
#  SOLVÈNE — environment configuration
#  Copy to .env and replace the placeholder values.
#  While a key still holds its placeholder, that integration runs
#  in "atelier preview" mode (simulated, logged to the console).
# ─────────────────────────────────────────────────────────────

PORT=3000
# Public base URL (used in logs / links). No trailing slash.
PUBLIC_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy (for correct client IPs).
TRUST_PROXY=0

# ── genlook.app virtual try-on ───────────────────────────────
# Create a key at https://app.genlook.app  (format: gk_...)
GENLOOK_API_KEY=gk_your_api_key_here
GENLOOK_BASE_URL=https://api.genlook.app/tryon/v1
# Genlook adds a watermark by default; disable on paid plans.
GENLOOK_WATERMARK=true
GENLOOK_TIMEOUT_MS=120000

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_GRAPH_VERSION=v21.0
# Any secret string; must match the one entered in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_string
# App secret — enables X-Hub-Signature-256 verification of webhooks.
WHATSAPP_APP_SECRET=
# Approved template asking the guest for a full-length photograph (no variables).
WHATSAPP_TEMPLATE_PORTRAIT=solvene_portrait_request
# Optional: approved template with an IMAGE header + 3 body variables
# ({{1}} first name, {{2}} piece name, {{3}} stylist note). Used to deliver
# each look even outside the 24-hour service window. Leave empty to send
# plain image messages instead.
WHATSAPP_TEMPLATE_LOOK=solvene_your_look
WHATSAPP_TEMPLATE_LANG=en

# ── Commerce ─────────────────────────────────────────────────
CURRENCY=INR
LOCALE=en-IN
DEFAULT_DIAL_CODE=+91
